generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
    ADMIN
    BARBER_BOSS
    BARBER_AFFILIATE
    BARBER_INDEPENDENT
}

enum AppointmentState {
    PENDING
    CONFIRMED
    COMPLETED
    CANCELLED
}

enum DayOfWeek {
    MONDAY
    TUESDAY
    WEDNESDAY
    THURSDAY
    FRIDAY
    SATURDAY
    SUNDAY
}

model User {
    id String @id @default(uuid())
    name String
    phone String @unique
    password String
    role Role 
    photo String
    state Boolean @default(true)
    description String
    haveWhatsApp Boolean @default(true)
    
    commissionRate Float @default(0.70) 
    
    failedAttempts Int @default(0)
    lockUntil DateTime?
    
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    businessHours BusinessHour[]
    appointmentBarber Appointment[] @relation("AppointmentBarber")
    historyAppointment HistoryAppointment[]
    services ServicesBarbers[]
}

model Services {
    id String @id @default(uuid())
    name String
    description String
    duration Int 
    price Float
    isActive Boolean @default(true) 
    
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    barbers ServicesBarbers[]
    appointment Appointment[]
    historyAppointment HistoryAppointment[]
}

model ServicesBarbers {
    barberId String
    serviceId String
    barber User @relation(fields: [barberId], references: [id], onDelete: Cascade)
    service Services @relation(fields: [serviceId], references: [id], onDelete: Cascade)

    @@id([barberId, serviceId])
}

model Appointment {
    id String @id @default(uuid())
    date DateTime
    timeSlot String 
    state AppointmentState @default(PENDING)
    priceAtBooking Float 
    
    clientId String
    client Clients @relation(fields: [clientId], references: [id], onDelete: Restrict) 

    barberId String
    barber User @relation("AppointmentBarber", fields: [barberId], references: [id], onDelete: Restrict)
    
    serviceId String
    service Services @relation(fields: [serviceId], references: [id], onDelete: Restrict)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    
    historyAppointment HistoryAppointment[]

    @@unique([barberId, date, timeSlot]) 
}



model Clients {
    id String @id @default(uuid())
    name String
    phone String @unique
    haveWhatsApp Boolean @default(true)
    appointments Appointment[]
    
    strikes Int @default(0)           // Cancelaciones tardías actuales
    blockCount Int @default(0)        // Cuántas veces ha sido bloqueado
    blockedUntil DateTime?            // Fecha de desbloqueo
    isBanned Boolean @default(false)  // Baneo permanente
    lastStrikeAt DateTime?            // Para limpiar strikes viejos
}

model BusinessHour {
    id String @id @default(uuid())
    day DayOfWeek
    timeSlot String 
    isActive Boolean @default(true)

    barberId String
    barber User @relation(fields: [barberId], references: [id], onDelete: Cascade)

    @@unique([barberId, day, timeSlot])
}

model HistoryAppointment {
    id String @id @default(uuid())
    state AppointmentState 
    changedAt DateTime @default(now()) 

    barberId String
    barber User @relation(fields: [barberId], references: [id], onDelete: Cascade)

    appointmentId String
    appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

    serviceId String
    service Services @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
    id        String   @id @default(uuid())
    phone     String
    otpCode   String
    expiresAt DateTime
    used      Boolean  @default(false)
    createdAt DateTime @default(now())
}