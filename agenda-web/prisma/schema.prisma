generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
    ADMIN
    BARBER_BOSS
    BARBER_AFFILIATE
    BARBER_INDEPENDENT
}

enum AppointmentState {
    PENDING
    CONFIRMED
    COMPLETED
    CANCELLED
}

enum DayOfWeek {
    MONDAY
    TUESDAY
    WEDNESDAY
    THURSDAY
    FRIDAY
    SATURDAY
    SUNDAY
}

model User {
    id String @id @default(uuid())
    name String
    email String? @unique // Agregado para login
    phone String @unique
    password String
    role Role 
    photo String?
    state Boolean @default(true)
    description String?
    haveWhatsApp Boolean @default(true)
    
    // Gestión de comisiones (Ej: 0.70 = 70% para el barbero)
    commissionRate Float @default(0.70) 
    
    // Seguridad
    failedAttempts Int @default(0)
    lockUntil DateTime?
    
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    businessHours BusinessHour[]
    appointmentBarber Appointment[] @relation("AppointmentBarber")
    historyAppointment HistoryAppointment[]
    services ServicesBarbers[]
}

model Services {
    id String @id @default(uuid())
    name String
    description String
    duration Int // En minutos
    price Float
    isActive Boolean @default(true) // Borrado lógico, no eliminamos el servicio
    
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    barbers ServicesBarbers[]
    appointment Appointment[]
    historyAppointment HistoryAppointment[]
}

model ServicesBarbers {
    barberId String
    serviceId String
    barber User @relation(fields: [barberId], references: [id], onDelete: Cascade)
    service Services @relation(fields: [serviceId], references: [id], onDelete: Cascade)

    @@id([barberId, serviceId])
}

model Appointment {
    id String @id @default(uuid())
    date DateTime
    timeSlot String // Ej: "09:00"
    state AppointmentState @default(PENDING)
    
    // Guardamos el precio histórico para que no cambie si el servicio sube de precio
    priceAtBooking Float 
    
    clientId String
    client Clients @relation(fields: [clientId], references: [id], onDelete: Restrict) // Restrict evita borrar clientes con citas

    barberId String
    barber User @relation("AppointmentBarber", fields: [barberId], references: [id], onDelete: Restrict)
    
    serviceId String
    service Services @relation(fields: [serviceId], references: [id], onDelete: Restrict)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    
    historyAppointment HistoryAppointment[]
}

model Clients {
    id String @id @default(uuid())
    name String
    phone String @unique // Un cliente no debería duplicarse por teléfono
    haveWhatsApp Boolean @default(true)
    appointments Appointment[]
}

model BusinessHour {
    id String @id @default(uuid())
    day DayOfWeek
    timeSlot String // Ej: "09:00"
    isActive Boolean @default(true)

    barberId String
    barber User @relation(fields: [barberId], references: [id], onDelete: Cascade)

    @@unique([barberId, day, timeSlot])
}

model HistoryAppointment {
    id String @id @default(uuid())
    state AppointmentState 
    changedAt DateTime @default(now()) // Para saber cuándo cambió de estado

    barberId String
    barber User @relation(fields: [barberId], references: [id], onDelete: Cascade)

    appointmentId String
    appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

    serviceId String
    service Services @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}